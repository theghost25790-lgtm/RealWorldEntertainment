  "canonical_field_rules": {
    "project_id": {
      "semantic_types": [
        "project"
      ],
      "nullable": false
    },
    "build_id": {
      "semantic_types": [
        "build"
      ],
      "nullable": false
    },
    "location_id": {
      "semantic_types": [
        "location"
      ],
      "nullable": false
    },
    "previous_location_id": {
      "semantic_types": [
        "location"
      ],
      "nullable": true
    },
    "next_location_id": {
      "semantic_types": [
        "location"
      ],
      "nullable": true
    }
  },
  "runtime_instance_namespaces": {
    "event_id": {
      "prefix": "EVT-",
      "pattern": "^EVT-[A-Za-z0-9][A-Za-z0-9_-]+$",
      "scope": "immutable event occurrence"
    },
    "installation_id": {
      "prefix": "INS-",
      "pattern": "^INS-[A-Za-z0-9][A-Za-z0-9_-]+$",
      "scope": "installation"
    },
    "session_id": {
      "prefix": "SES-",
      "pattern": "^SES-[A-Za-z0-9][A-Za-z0-9_-]+$",
      "scope": "session"
    },
    "tester_id": {
      "prefix": "TST-",
      "pattern": "^TST-[A-Za-z0-9][A-Za-z0-9_-]+$",
      "scope": "longitudinal tester",
      "nullable": true
    },
    "player_instance_id": {
      "prefix": "PLY-",
      "pattern": "^PLY-[A-Za-z0-9][A-Za-z0-9_-]+$",
      "scope": "per-session player actor",
      "nullable": true
    },
    "weapon_instance_id": {
      "prefix": "WPNI-",
      "pattern": "^WPNI-[A-Za-z0-9][A-Za-z0-9_-]+$",
      "scope": "spawned firearm instance"
    },
    "magazine_instance_id": {
      "prefix": "MAGI-",
      "pattern": "^MAGI-[A-Za-z0-9][A-Za-z0-9_-]+$",
      "scope": "spawned magazine instance"
    },
    "npc_instance_id": {
      "prefix": "NPCI-",
      "pattern": "^NPCI-[A-Za-z0-9][A-Za-z0-9_-]+$",
      "scope": "spawned NPC instance"
    },
    "combat_id": {
      "prefix": "CMB-",
      "pattern": "^CMB-[A-Za-z0-9][A-Za-z0-9_-]+$",
      "scope": "combat context"
    }
  },
  "asset_identity": {
    "weapon_asset": {
      "identity_class": "ue_asset",
      "registry_status": "exact asset registry pending",
      "known_examples": [
        "MT-09_A",
        "v57",
        "Mac 10"
      ],
      "parent_contract": "BP_Pistol",
      "rule": "A concrete firearm asset is not promoted to an RWE archive record merely because it appears in telemetry."
    },
    "magazine_asset": {
      "identity_class": "ue_asset",
      "registry_status": "exact asset registry pending",
      "known_examples": [],
      "parent_contract": "BP_Mag",
      "rule": "Magazine child identity remains separate from the BP_Mag semantic parent contract."
    },
    "form_id": {
      "identity_class": "permanent content asset",
      "pattern": "^F\\d{7}$",
      "rule": "Project 2088 Asset Database universal FormID. Separate from runtime instance IDs and gameplay child asset names."
    }
  },
